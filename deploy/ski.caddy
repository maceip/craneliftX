# Public routing for the dedicated Ski service on vectorheart.
ski.public.computer {
    @assets path /dist/*
    header @assets Cache-Control "no-cache"
    header X-Content-Type-Options "nosniff"
    request_body {
        max_size 67108864
    }
    reverse_proxy 127.0.0.1:8879 {
        flush_interval -1
    }
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
        }
    }
}
