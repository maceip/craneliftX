[Unit]
Description=Chunder live ISR demo coordinator
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/craneliftx
Environment=ISR_STATE_DIR=/var/lib/craneliftx
Environment=ISR_WORKER=/var/www/craneliftx/target/release/isr-demo
ExecStart=/var/www/craneliftx/.venv/bin/python webapp/server.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=2
StateDirectory=craneliftx
KillMode=control-group
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
