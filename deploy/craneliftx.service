[Unit]
Description=CraneliftX Multi-ISA Lowering & Visualization Daemon
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/craneliftx
Environment=PATH=/var/www/craneliftx/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/var/www/craneliftx/.venv/bin/python3 webapp/server.py --port 8765 --host 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
