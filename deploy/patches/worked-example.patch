+import { test, expect } from "@playwright/test";
+import { readFileSync } from "node:fs";
+
+test("Worked example: real Baby values, all five stages, keyboard and mobile", async ({ page }, testInfo) => {
+  const errors: string[] = [];
+  page.on("pageerror", error => errors.push(error.message));
+  await page.goto("/");
+  const guide = page.getByRole("region", { name: "Worked example" });
+  await expect(guide.getByText(/Baby preset preview/)).toBeVisible();
+  await expect(guide.locator(".record-words code")).toHaveText(["1", "2", "3", "4", "5", "6", "7", "0"]);
+  await guide.getByRole("button", { name: "Next step" }).focus();
+  await page.keyboard.press("Enter");
+  await expect(guide.getByRole("heading", { name: /Check the rules/ })).toBeVisible();
+  await expect(guide.getByRole("button", { name: /02 · Audit/ })).toHaveAttribute("aria-pressed", "true");
+  await guide.getByRole("button", { name: /05 · Execute/ }).click();
+  await expect(guide.getByText("Nothing has executed yet.", { exact: false })).toBeVisible();
+  await expect(guide.locator(".comparison-result")).toHaveCount(0);
+
+  await page.getByRole("button", { name: "Run Baby", exact: true }).click();
+  await expect(page.getByRole("heading", { name: "Verified", exact: true })).toBeVisible();
+  const id = new URL(page.url()).searchParams.get("run");
+  const report = await (await page.request.get(`/api/runs/${id}`)).json();
+  expect(report.result.mismatches).toBe(0);
+  expect(report.context.rax_after).toBe("0x000000000000007d");
+  expect(report.context.rcx_after).toBe("0x0000000000000007");
+  expect(report.context.memory_after.slice(0, 112)).toBe(report.context.memory_before.slice(0, 112));
+  expect(report.context.memory_after.slice(112)).toBe("7d00000000000000");
+  expect(BigInt(report.context.rip_after) - BigInt(report.context.rip_before)).toBe(64n);
+  await expect(guide.getByText(/Recorded from Baby run/)).toBeVisible();
+  await expect(guide.locator(".calculation code")).toHaveText(["28", "54", "108", "125", "125"]);
+  await expect(guide.getByText("Observed output: 125", { exact: true })).toBeVisible();
+  await expect(guide.getByText(/Verified by the worker/)).toBeVisible();
+  await expect(guide.locator(".delta-table")).toContainText(report.context.rip_after);
+
+  const stageButtons = guide.locator(".pipeline button");
+  for (let stage = 0; stage < 5; stage++) {
+    await stageButtons.nth(stage).click();
+    await expect(stageButtons.nth(stage)).toHaveAttribute("aria-pressed", "true");
+    if (stage === 0) {
+      await expect(guide.getByText("18 instructions + RET boundary")).toBeVisible();
+      await expect(guide.locator(".record-words code")).toHaveText(["1", "2", "3", "4", "5", "6", "7", "0"]);
+    }
+    if (stage === 1) await expect(guide.getByText("Rejected before codegen", { exact: true })).toBeVisible();
+    if (stage === 2) {
+      await guide.getByText("Inspect the actual Cranelift IR", { exact: true }).click();
+      await expect(guide.locator("pre")).toHaveText(report.artifacts["0"].clif);
+    }
+    if (stage === 3) {
+      await expect(guide.getByText(`${report.artifacts["0"].riscv.length / 2} bytes of compiled output`)).toBeVisible();
+      await guide.getByText("Inspect all emitted RISC-V bytes", { exact: true }).click();
+      await expect(guide.locator("details pre")).toHaveText(report.artifacts["0"].riscv.match(/.{1,48}/g).join("\n"));
+    }
+    await guide.screenshot({ path: testInfo.outputPath(`stage-${stage + 1}.png`) });
+  }
+  await page.screenshot({ path: testInfo.outputPath("baby-desktop.png"), fullPage: true });
+  await page.setViewportSize({ width: 390, height: 844 });
+  for (let stage = 0; stage < 5; stage++) {
+    await stageButtons.nth(stage).click();
+    expect(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth)).toBe(true);
+    await guide.screenshot({ path: testInfo.outputPath(`mobile-stage-${stage + 1}.png`) });
+  }
+  await page.reload();
+  await guide.getByRole("button", { name: /05 · Execute/ }).click();
+  await expect(guide.getByText("Observed output: 125", { exact: true })).toBeVisible();
+  expect(errors).toEqual([]);
+  await testInfo.attach("worked-example-report.json", { body: JSON.stringify(report, null, 2), contentType: "application/json" });
+});
+
+test("Saved reports retain their original values rather than the new Baby preset", async ({ page }) => {
+  // Actual public report captured before the Baby preset changed; replay fixture only.
+  const old = JSON.parse(readFileSync(new URL("./fixtures/legacy-baby.json", import.meta.url), "utf8"));
+  await page.route(`**/api/runs/${old.id}`, route => route.fulfill({ json: old }));
+  await page.goto(`/?run=${old.id}`);
+  const guide = page.getByRole("region", { name: "Worked example" });
+  await expect(guide.locator(".record-words code").first()).toHaveText("0xabababababababab");
+  await guide.getByRole("button", { name: /05 · Execute/ }).click();
+  await expect(guide.getByText("Observed output: 0x636363636363631f", { exact: true })).toBeVisible();
+  await expect(guide.locator(".calculation code").last()).toHaveText("0x636363636363631f");
+  await expect(guide.locator(".delta-table")).toContainText(old.context.rip_after);
+  await expect(guide.getByText("Observed output: 125", { exact: true })).toHaveCount(0);
+});
