+import React, { useState } from "react";
+import { number, Snapshot, text } from "./protocol";
+
+export type StageRow = {
+  stage: string;
+  finished: number;
+  expected: number;
+  state: string;
+  ns: number;
+};
+
+const steps = [
+  { title: "Read the x86 code", short: "Read code", term: "Harvest" },
+  { title: "Check the rules", short: "Check rules", term: "Audit" },
+  { title: "Express the same computation", short: "Build IR", term: "Cranelift IR" },
+  { title: "Make RISC-V machine code", short: "Emit RISC-V", term: "Codegen" },
+  { title: "Run it and compare the result", short: "Run & compare", term: "Execute" },
+];
+const mask = (1n << 64n) - 1n;
+const preset = [1n, 2n, 3n, 4n, 5n, 6n, 7n, 0n];
+const display = (value: bigint) =>
+  value <= 999999999n ? value.toLocaleString("en-US") : hex(value);
+const hex = (value: bigint) => `0x${value.toString(16).padStart(16, "0")}`;
+const time = (ns: number) =>
+  ns >= 1e9 ? `${(ns / 1e9).toFixed(2)} s` : `${(ns / 1e6).toFixed(2)} ms`;
+
+function words(raw: string): bigint[] | null {
+  if (!/^[0-9a-f]{128}$/i.test(raw)) return null;
+  return Array.from({ length: 8 }, (_, index) =>
+    BigInt(`0x${raw.slice(index * 16, index * 16 + 16).match(/../g)!.reverse().join("")}`),
+  );
+}
+function integer(raw: string): bigint | null {
+  return /^(0x[0-9a-f]+|[0-9]+)$/i.test(raw) ? BigInt(raw) : null;
+}
+function calculation(input: bigint[], seed: bigint) {
+  const sum = input.slice(0, 7).reduce((a, b) => (a + b) & mask, 0n);
+  const mixed = sum ^ seed;
+  const shifted = (mixed << 1n) & mask;
+  const added = (shifted + 17n) & mask;
+  return [sum, mixed, shifted, added, added | 5n];
+}
+
+function Transfer({ input, output }: { input: React.ReactNode; output: React.ReactNode }) {
+  return (
+    <div className="step-transfer">
+      <div><span className="io-label">Input</span>{input}</div>
+      <span className="transfer-arrow" aria-hidden="true">→</span>
+      <div><span className="io-label">Output</span>{output}</div>
+    </div>
+  );
+}
+
+export function WorkedExample({ run, stages }: { run: Snapshot | null; stages: StageRow[] }) {
+  const [step, setStep] = useState(0);
+  const artifact = run?.artifacts["0"];
+  const network = !!run && run.tier !== "baby";
+  const before = !network ? words(text(run?.context, "memory_before")) : null;
+  const after = !network ? words(text(run?.context, "memory_after")) : null;
+  const seed = integer(run?.seed ?? "42") ?? 42n;
+  const input = before ?? preset;
+  const values = calculation(input, seed);
+  const completed = run?.status === "completed" && run.result?.mismatches === 0;
+  const captured = !!before && !!after;
+  const auditPassed = run?.stages["0:audit"]?.state === "completed";
+  const syscallRejected = run?.security?.syscall_rejected === true && run.security.codegen_invoked === false;
+  const decoded = number(artifact, "instructions");
+  const riscv = text(artifact, "riscv");
+  const byteCount = riscv.length / 2;
+  const clif = text(artifact, "clif");
+  const entry = text(artifact, "entry_rip");
+  const exit = text(artifact, "exit_rip");
+  const delta = entry && exit ? BigInt(exit) - BigInt(entry) : null;
+  const evidence = captured
+    ? `Recorded from Baby run ${run!.id.slice(0, 8)} · seed ${run!.seed}`
+    : network
+      ? "Kernel 0 from this network run · individual records are not recorded"
+      : "Baby preset preview · run Baby to capture real values and generated code";
+
+  return (
+    <section className="walkthrough" aria-label="Worked example">
+      <div className="walkthrough-heading">
+        <h3>One record, five steps</h3>
+        <p>Read seven numbers, mix their sum with a seed, and write one answer. Follow how the engine carries that computation into a different instruction set.</p>
+      </div>
+      <ol className="pipeline">
+        {stages.map((row, index) => (
+          <li key={row.stage} data-state={row.state}>
+            <button type="button" aria-pressed={step === index} aria-controls="worked-step" onClick={() => setStep(index)}>
+              <span className="stage-number">0{index + 1} · {steps[index].term}</span>
+              <strong>{steps[index].short}</strong>
+              <span>{row.state}{row.expected > 1 && row.finished > 0 ? ` · ${row.finished}/${row.expected}` : ""}</span>
+              <small>{row.ns ? time(row.ns) : "—"}</small>
+            </button>
+          </li>
+        ))}
+      </ol>
+      <div id="worked-step" className="worked-step">
+        <p className="example-provenance">{evidence}</p>
+        <h4><span className="step-index">0{step + 1}</span>{steps[step].title}</h4>
+
+        {step === 0 && <>
+          <p>The worker starts at <strong>RIP</strong>, the address of the next x86 instruction. It reads a short block and stops at the return instruction, <code>RET</code>.</p>
+          <Transfer
+            input={<><strong>Live x86 function</strong><code>{entry || "RIP supplied when the run starts"}</code></>}
+            output={<><strong>{decoded ? `${decoded - 1} instructions + RET boundary` : "A decoded instruction list"}</strong><span>The return boundary is inspected, but not translated.</span></>}
+          />
+          {!network && <div className="record-view">
+            <div className="record-label"><strong>{captured ? "Captured input record" : "Baby input preset"}</strong><span>64 bytes = eight 64-bit words</span></div>
+            <div className="record-words">
+              {input.slice(0, 7).map((value, index) => <div key={index}><span>Number {index + 1}</span><code>{display(value)}</code></div>)}
+              <div className="output-word"><span>Output slot</span><code>{display(input[7])}</code></div>
+            </div>
+            <p className="step-note">The first seven words are inputs. The last word reserves space for the answer. RDI holds the address of this record; RSI holds seed {run?.seed ?? "42"}.</p>
+          </div>}
+          {network && <p className="step-note">Each network record has seven input words and one output word. Run Baby to inspect one record’s exact values from start to finish.</p>}
+          <details className="step-evidence"><summary>Connect the x86 instructions to the example</summary>
+            <pre>{"mov rax, [rdi]       ; read number 1\nmov rcx, [rdi + 8]   ; read number 2\nadd rax, rcx         ; add them\n…                   ; read and add numbers 3–7\nxor rax, rsi         ; mix in the seed\nshl rax, 1           ; shift left one bit\nadd rax, 17          ; add 17\nor  rax, 5           ; set the bits selected by 5\nmov [rdi + 56], rax  ; write the answer\nret                 ; stop here: leave RET to the caller"}</pre>
+            <p className="step-note">Annotated excerpt of the fixed kernel; the repeated additions are abbreviated.</p>
+            {artifact && <><h5>Exact x86 bytes from this run</h5><pre>{text(artifact, "x86").match(/.{1,48}/g)?.join("\n")}</pre></>}
+          </details>
+        </>}
+
+        {step === 1 && <>
+          <p>Before compiling, the audit checks the decoded instructions for forbidden system calls, unexpected stack-pointer changes, and disallowed absolute addresses.</p>
+          <Transfer
+            input={<><strong>The same decoded block</strong><span>Instructions from step 1</span></>}
+            output={<><strong>{auditPassed ? "This block passed its audit" : "Accept the block, or stop"}</strong><span>{auditPassed ? "Kernel 0 can proceed to Cranelift." : "A rejected block never reaches the compiler."}</span></>}
+          />
+          <div className="rule-check">
+            <div><strong>What this example does</strong><p>Reads the record through RDI, calculates an answer, and writes it back. It makes no system call and does not reassign RSP, the stack pointer.</p></div>
+            <div><strong>Separate rejection check</strong><p><code>0f 05</code> → <code>SYSCALL</code> → <strong>{syscallRejected ? "Rejected before codegen" : "must be rejected"}</strong></p><span className="step-note">{syscallRejected ? "The worker reported that compilation was never invoked for this test." : "Every run tests this forbidden two-byte buffer separately from the example."}</span></div>
+          </div>
+          <p className="step-note">This audit checks instruction rules. Register-based memory pointers still belong to the host process; it is not a memory sandbox.</p>
+        </>}
+
+        {step === 2 && <>
+          <p><strong>Cranelift IR</strong> (also called CLIF) is the compiler’s intermediate language. It describes the same reads, arithmetic, and writes without using x86 machine instructions.</p>
+          <Transfer
+            input={<><strong>Audited x86 instructions</strong><span>The computation from steps 1 and 2</span></>}
+            output={<><strong>One Cranelift function</strong><span>Reads the register context, performs the work, and saves updated registers.</span></>}
+          />
+          <table className="meaning-table"><thead><tr><th>x86 operation</th><th>Cranelift IR</th><th>Meaning in this example</th></tr></thead><tbody>
+            <tr><td><code>MOV</code> from memory</td><td><code>load.i64</code></td><td>Read a 64-bit number from the record.</td></tr>
+            <tr><td><code>ADD</code></td><td><code>iadd</code></td><td>Add it to the running sum.</td></tr>
+            <tr><td><code>XOR / SHL / OR</code></td><td><code>bxor / ishl / bor</code></td><td>Mix the seed and adjust the answer.</td></tr>
+            <tr><td><code>MOV</code> to memory</td><td><code>store</code></td><td>Save the answer in the output slot.</td></tr>
+          </tbody></table>
+          <details className="step-evidence"><summary>Inspect the actual Cranelift IR</summary>{clif ? <pre>{clif}</pre> : <p>Run Baby to see the compiler’s generated IR here.</p>}</details>
+        </>}
+
+        {step === 3 && <>
+          <p>Cranelift compiles that function into <strong>RISC-V machine code</strong>. The computation stays the same; the instruction encoding changes.</p>
+          <Transfer
+            input={<><strong>The Cranelift function</strong><span>Output from step 3</span></>}
+            output={<><strong>{byteCount ? `${byteCount} bytes of compiled output` : "RISC-V machine bytes"}</strong><span>Instructions and embedded data for the interpreter.</span></>}
+          />
+          <div className="target-lock"><span>Backend target</span><code>riscv64gc-unknown-none-elf</code></div>
+          {riscv ? <div className="machine-bytes"><p>Beginning of the actual compiled output</p><pre>{riscv.slice(0, 64).match(/.{1,8}/g)?.join(" ")}</pre></div> : <p className="step-note">Actual machine bytes appear here after the worker compiles the trace.</p>}
+          <p className="step-note">The embedded core executes fixed-width RV64 instructions. The host CPU does not execute these RISC-V bytes directly.</p>
+          <details className="step-evidence"><summary>Inspect all emitted RISC-V bytes</summary>{riscv ? <pre>{riscv.match(/.{1,48}/g)?.join("\n")}</pre> : <p>Run Baby to capture the generated code.</p>}</details>
+        </>}
+
+        {step === 4 && <>
+          <p>The embedded RISC-V core executes the generated instructions against the record and register context. The worker compares the result with an independent Rust calculation{String(run?.engine?.oracle ?? "").includes("native-x86") ? " and the native x86 function" : "; on an x86 host it also checks the native function"}.</p>
+          {!network && <>
+            <div className="calculation-label"><strong>{captured ? "Calculation from the captured inputs" : "Expected calculation for the Baby preset"}</strong><span>Unsigned 64-bit arithmetic</span></div>
+            <ol className="calculation">
+              {["Sum 7 inputs", `XOR seed ${run?.seed ?? "42"}`, "Shift left 1 bit", "Add 17", "OR with 5"].map((label, index) => <li key={label}><span>{label}</span><code>{display(values[index])}</code></li>)}
+            </ol>
+            <p className="step-note">XOR mixes bits that differ; OR sets the bits selected by 5. Values wrap at 64 bits. This arithmetic explanation is calculated from the inputs; the observed output below comes from the worker.</p>
+          </>}
+          <Transfer
+            input={<><strong>RISC-V code + register context</strong><span>{network ? "Reused for dependent passes across network records." : "The input record and seed from step 1."}</span></>}
+            output={<><strong>{captured ? `Observed output: ${display(after![7])}` : network && completed ? `${number(run?.result, "verified").toLocaleString("en-US")} records verified` : "Updated registers and memory"}</strong><span>{completed ? `Worker comparison: ${number(run?.result, "mismatches")} mismatches.` : "A match is reported only after the worker finishes successfully."}</span></>}
+          />
+          {captured && <table className="delta-table"><thead><tr><th>What changed</th><th>Before</th><th>After</th></tr></thead><tbody>
+            <tr><th>Output word <small>Bytes 56–63</small></th><td><code>{display(before![7])}</code></td><td><code>{display(after![7])}</code></td></tr>
+            {["rax", "rcx", "rip"].map(field => <tr key={field}><th>{field.toUpperCase()}<small>{field === "rax" ? "Answer register" : field === "rcx" ? "Last input read" : "Next x86 instruction"}</small></th><td><code>{text(run?.context, `${field}_before`)}</code></td><td><code>{text(run?.context, `${field}_after`)}</code></td></tr>)}
+          </tbody></table>}
+          {captured && <p className="step-note">The seven input words stay unchanged. All 16 general-purpose registers and the exit RIP are checked; the table shows the changed fields. {delta !== null && `RIP advances ${delta} bytes to RET.`} This demo does not resume native execution.</p>}
+          {network && <p className="step-note">This run records aggregate verification, not individual before/after records. Select Baby above for a complete single-record walkthrough.</p>}
+          {!run && <p className="step-note">Nothing has executed yet. Run Baby above to replace this preview with captured evidence.</p>}
