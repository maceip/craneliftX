+.walkthrough { margin: 0 0 28px; }
+.walkthrough-heading { max-width: 760px; margin-bottom: 20px; }
+.walkthrough-heading h3 { font-size: 17px; margin: 0 0 8px; }
+.walkthrough-heading p, .worked-step > p { font-size: 14px; line-height: 1.65; color: #526173; margin: 0 0 18px; }
+.walkthrough .pipeline { margin-bottom: 0; }
+.walkthrough .pipeline li { padding: 0; border: 0; background: none; display: block; }
+.walkthrough .pipeline button { width: 100%; min-height: 111px; padding: 13px; display: flex; flex-direction: column; gap: 7px; text-align: left; border: 1px solid #d8dce3; font-weight: 400; }
+.walkthrough .pipeline button > span:not(.stage-number) { font-size: 11px; color: #596371; }
+.walkthrough .pipeline li[data-state="Complete"] button { background: #f8fbf9; border-color: #bed7cb; }
+.walkthrough .pipeline li[data-state="Failed"] button { border-color: #b63e3e; }
+.walkthrough .pipeline button[aria-pressed="true"] { border-color: #245bc1; box-shadow: 0 0 0 1px #245bc1; }
+.walkthrough .pipeline button:hover { border-color: #245bc1; }
+.worked-step { border: 1px solid #d8dce3; border-radius: 10px; margin-top: 16px; padding: 22px; background: #fff; }
+.worked-step .example-provenance { font-size: 11px; margin-bottom: 15px; color: #596371; }
+.worked-step h4 { font-size: 19px; display: flex; align-items: center; gap: 12px; margin: 0 0 15px; }
+.step-index { border-radius: 6px; padding: 7px; font: 12px ui-monospace, monospace; color: #245bc1; background: #eef3fc; flex-shrink: 0; }
+.worked-step h5 { font-size: 12px; margin: 18px 0 8px; }
+.step-transfer { display: grid; grid-template-columns: minmax(0,1fr) 32px minmax(0,1fr); align-items: stretch; margin: 20px 0; }
+.step-transfer > div { display: flex; flex-direction: column; gap: 8px; background: #f5f6f8; border-radius: 8px; padding: 16px; min-width: 0; }
+.step-transfer .io-label { color: #596371; text-transform: uppercase; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
+.step-transfer strong { font-size: 14px; line-height: 1.5; }
+.step-transfer div > span:not(.io-label), .step-transfer code { font-size: 12px; line-height: 1.6; color: #526173; overflow-wrap: anywhere; }
+.transfer-arrow { align-self: center; text-align: center; font-size: 21px; color: #245bc1; }
+.record-label, .calculation-label { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px; font-size: 12px; margin: 20px 0 12px; }
+.record-label > span, .calculation-label > span { color: #596371; font-size: 11px; }
+.record-words { display: grid; grid-template-columns: repeat(8,minmax(0,1fr)); gap: 6px; }
+.record-words > div { border: 1px solid #d8dce3; border-radius: 6px; padding: 11px 8px; min-width: 0; }
+.record-words span { font-size: 10px; color: #596371; display: block; margin-bottom: 9px; }
+.record-words code { font-size: 15px; display: block; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
+.record-words .output-word { border-style: dashed; border-color: #245bc1; background: #f5f8fe; }
+.worked-step .step-note { font-size: 12px; line-height: 1.65; color: #596371; margin: 12px 0; }
+.step-evidence { border-top: 1px solid #d8dce3; padding-top: 16px; margin-top: 20px; }
+.step-evidence summary { font-size: 13px; font-weight: 600; cursor: pointer; color: #245bc1; }
+.step-evidence > p { font-size: 13px; color: #526173; line-height: 1.6; }
+.step-evidence pre { max-height: 300px; margin-bottom: 0; }
+.rule-check { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 22px; margin-top: 23px; }
+.rule-check strong { font-size: 13px; }
+.rule-check p { font-size: 13px; line-height: 1.65; color: #526173; margin: 10px 0; }
+.worked-step .meaning-table { font-family: inherit; font-size: 12px; }
+.worked-step .meaning-table th:first-child { width: 27%; }
+.worked-step .meaning-table th:nth-child(2) { width: 29%; }
+.worked-step th { font-size: 11px; }
+.worked-step th, .worked-step td { padding: 10px 8px; line-height: 1.6; }
+.target-lock { display: flex; flex-wrap: wrap; gap: 10px 20px; background: #f5f6f8; border-radius: 8px; padding: 14px 16px; font-size: 12px; }
+.target-lock > span { color: #596371; }
+.target-lock code { overflow-wrap: anywhere; }
+.machine-bytes p { font-size: 12px; color: #596371; margin-top: 20px; }
+.machine-bytes pre { white-space: pre-wrap; overflow-wrap: anywhere; }
+.calculation { list-style: none; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); padding: 0; margin: 0; gap: 8px; }
+.calculation li { border-left: 2px solid #d8dce3; padding: 9px 12px; min-width: 0; }
+.calculation li:last-child { border-color: #245bc1; background: #f5f8fe; }
+.calculation span { display: block; font-size: 11px; color: #596371; margin-bottom: 10px; }
+.calculation code { font-size: 20px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
+.worked-step .delta-table { font-family: inherit; }
+.worked-step .delta-table th:first-child { width: 24%; }
+.delta-table th small { display: block; font-weight: 400; color: #596371; font-size: 10px; }
+.delta-table td code { font-size: 11px; }
+.worked-step .comparison-result { font-size: 12px; border-left: 3px solid #c5cad2; background: #f5f6f8; padding: 12px 14px; margin-top: 18px; }
+.worked-step .comparison-result.is-verified { border-color: #286046; color: #286046; background: #f8fbf9; }
+.walkthrough-nav { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 24px; padding-top: 18px; border-top: 1px solid #d8dce3; }
+.walkthrough-nav > span { font-size: 11px; color: #596371; }
+.walkthrough-nav > div { display: flex; gap: 8px; }
+.walkthrough-nav button { font-size: 12px; padding: 9px 12px; }
+@media (max-width: 760px) {
+  .walkthrough .pipeline { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
+  .walkthrough .pipeline li:last-child { grid-column: 1 / -1; }
+  .walkthrough .pipeline button { min-height: 0; display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 7px; padding: 12px; }
+  .walkthrough .pipeline .stage-number, .walkthrough .pipeline strong { grid-column: 1 / -1; min-height: 0; }
+  .walkthrough .pipeline strong { font-size: 13px; }
+  .walkthrough .pipeline small { font-size: 10px; }
+  .worked-step { padding: 15px; }
+  .worked-step h4 { font-size: 17px; align-items: flex-start; line-height: 1.4; }
+  .worked-step > p, .walkthrough-heading p { font-size: 13px; }
+  .step-transfer { grid-template-columns: minmax(0,1fr); gap: 7px; }
+  .step-transfer > div { padding: 12px; }
+  .transfer-arrow { transform: rotate(90deg); font-size: 17px; }
+  .record-words { grid-template-columns: repeat(4,minmax(0,1fr)); }
+  .record-words code { font-size: 12px; }
+  .record-words span { font-size: 9px; }
+  .rule-check { grid-template-columns: minmax(0,1fr); gap: 10px; }
+  .worked-step .meaning-table { font-size: 11px; }
+  .worked-step th, .worked-step td { padding: 9px 4px; }
+  .calculation { grid-template-columns: repeat(2,minmax(0,1fr)); }
+  .calculation li:last-child { grid-column: 1 / -1; }
+  .calculation code { font-size: 17px; }
+  .delta-table td code { font-size: 10px; }
+}
